{
  "version": 8,
  "name": "Prayer Walk — Blacksburg regional basemap",
  "metadata": {
    "bpw:note": "The ground the mission is drawn on. Every colour here is checked against src/map/tokens.ts by src/map/__tests__/basemap.test.ts.",
    "bpw:source": "USGS The National Map (Transportation, Hydrography, Small-scale) and GNIS. Public domain — 17 U.S.C. 105. No OpenStreetMap geometry.",
    "bpw:extent": "-81.00,36.80 to -79.80,37.65 — roughly 50 km around Blacksburg.",
    "bpw:palette": "Sampled off the approved reference render rather than chosen: ground #0F1518, roads #34393C..#44494C, labels outside the town #42474A..#4D5255. See docs/20 §3.",
    "bpw:labels": "TWO TIERS, SPLIT BY THE MUNICIPAL LINE. Everything in this document is the outside tier and is deliberately dim. The bright tier — the neighbourhood names and BLACKSBURG — is drawn by the app from its own data, above this whole document. See src/map/style.ts."
  },
  "glyphs": "/fonts/{fontstack}/{range}.pbf",
    "sources": {
    "bpw-base": {
      "type": "vector",
      "url": "pmtiles:///basemap/blacksburg.pmtiles",
      "attribution": "<a href=\"https://www.usgs.gov/programs/national-geospatial-program/national-map\">USGS National Map</a>"
    },
    "bpw-boundary": {
      "type": "geojson",
      "data": "/basemap/boundary.json"
    }
  },
  "layers": [
    {
      "id": "bg-land",
      "type": "background",
      "paint": { "background-color": "#0F1518" }
    },

    {
      "id": "bg-forest",
      "type": "fill",
      "source": "bpw-base",
      "source-layer": "land",
      "paint": { "fill-color": "#141A18", "fill-opacity": 1 }
    },

    {
      "id": "bg-water",
      "type": "fill",
      "source": "bpw-base",
      "source-layer": "water",
      "paint": { "fill-color": "#141821", "fill-opacity": 1 }
    },
    {
      "id": "bg-waterway",
      "type": "line",
      "source": "bpw-base",
      "source-layer": "waterway",
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#1C242D",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          8, ["case", ["to-boolean", ["get", "major"]], 0.8, 0.3],
          11, ["case", ["to-boolean", ["get", "major"]], 1.6, 0.5],
          14, ["case", ["to-boolean", ["get", "major"]], 2.4, 1.0],
          17, ["case", ["to-boolean", ["get", "major"]], 4.4, 1.8]
        ]
      }
    },

    {
      "id": "bg-rail",
      "type": "line",
      "source": "bpw-base",
      "source-layer": "rail",
      "minzoom": 11,
      "paint": {
        "line-color": "#262B2E",
        "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.5, 14, 0.8, 17, 1.3],
        "line-dasharray": [2.5, 3]
      }
    },

    {
      "id": "bg-road-minor",
      "type": "line",
      "source": "bpw-base",
      "source-layer": "roads",
      "minzoom": 10,
      "filter": ["in", ["get", "class"], ["literal", ["minor", "link", "tertiary"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#34393C",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0.7, 12.5, 1],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          10, 0.5, 14, 1.1, 16, 2.0, 18, 3.4
        ]
      }
    },
    {
      "id": "bg-road-secondary",
      "type": "line",
      "source": "bpw-base",
      "source-layer": "roads",
      "minzoom": 10,
      "filter": ["==", ["get", "class"], "secondary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#383D40",
        "line-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0.6, 12, 1],
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          10, 0.55, 12, 0.8, 14, 1.5, 16, 2.8, 18, 4.6
        ]
      }
    },
    {
      "id": "bg-road-primary",
      "type": "line",
      "source": "bpw-base",
      "source-layer": "roads",
      "minzoom": 9,
      "filter": ["==", ["get", "class"], "primary"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#3C4144",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          9, 0.55, 12, 0.95, 14, 1.75, 16, 3.2, 18, 5.4
        ]
      }
    },
    {
      "id": "bg-road-trunk",
      "type": "line",
      "source": "bpw-base",
      "source-layer": "roads",
      "minzoom": 7,
      "filter": ["==", ["get", "class"], "trunk"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#404548",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          7, 0.5, 10, 0.9, 12, 1.2, 14, 2.1, 16, 3.9, 18, 6.5
        ]
      }
    },
    {
      "id": "bg-road-motorway",
      "type": "line",
      "source": "bpw-base",
      "source-layer": "roads",
      "minzoom": 7,
      "filter": ["==", ["get", "class"], "motorway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": {
        "line-color": "#44494C",
        "line-width": [
          "interpolate", ["linear"], ["zoom"],
          7, 0.7, 10, 1.1, 12, 1.45, 14, 2.5, 16, 4.6, 18, 7.6
        ]
      }
    },

    {
      "id": "bg-town-line",
      "type": "line",
      "source": "bpw-boundary",
      "layout": { "line-cap": "butt", "line-join": "round" },
      "paint": {
        "line-color": "#FFFFFF",
        "line-opacity": 0.55,
        "line-dasharray": [1.6, 2.4],
        "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.9, 12, 1.1, 16, 1.5]
      }
    },

    {
      "id": "bg-waterway-label",
      "type": "symbol",
      "source": "bpw-base",
      "source-layer": "waterway",
      "minzoom": 11,
      "filter": ["all", ["has", "name"], ["to-boolean", ["get", "major"]]],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["Prayer Walk Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 11, 5.5, 15, 6.5],
        "text-letter-spacing": 0.12,
        "text-max-angle": 32,
        "symbol-spacing": 420
      },
      "paint": {
        "text-color": "#3A4145",
        "text-halo-color": "#0F1518",
        "text-halo-width": 1.1
      }
    },

    {
      "id": "bg-shield",
      "type": "symbol",
      "source": "bpw-base",
      "source-layer": "roads",
      "minzoom": 10,
      "filter": ["all", ["has", "ref"], ["in", ["get", "class"], ["literal", ["motorway", "trunk", "primary"]]]],
      "layout": {
        "symbol-placement": "line",
        "symbol-spacing": 330,
        "text-field": ["case",
          ["==", ["slice", ["get", "ref"], 0, 2], "I-"], ["slice", ["get", "ref"], 2],
          ["==", ["slice", ["get", "ref"], 0, 3], "US "], ["slice", ["get", "ref"], 3],
          ["==", ["slice", ["get", "ref"], 0, 3], "VA "], ["slice", ["get", "ref"], 3],
          ["get", "ref"]],
        "text-font": ["Prayer Walk Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 5.2, 15, 6.4],
        "text-letter-spacing": 0.02,
        "text-rotation-alignment": "viewport",
        "text-pitch-alignment": "viewport",
        "text-padding": 4,
        "icon-image": ["case",
          ["==", ["slice", ["get", "ref"], 0, 2], "I-"], "shield-i",
          ["==", ["slice", ["get", "ref"], 0, 3], "US "], "shield-us",
          "shield-state"],
        "icon-text-fit": "both",
        "icon-text-fit-padding": [1, 2, 1, 2],
        "icon-rotation-alignment": "viewport",
        "icon-allow-overlap": false,
        "text-allow-overlap": false
      },
      "paint": {
        "text-color": "#6A6F72",
        "icon-opacity": 0.9,
        "text-opacity": 0.95
      }
    },

    {
      "id": "bg-place-terrain",
      "type": "symbol",
      "source": "bpw-base",
      "source-layer": "place",
      "minzoom": 10,
      "maxzoom": 14,
      "filter": ["==", ["get", "kind"], "terrain"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Prayer Walk Regular"],
        "text-transform": "uppercase",
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 5.2, 13, 6.2],
        "text-letter-spacing": 0.2,
        "text-max-width": 7,
        "text-line-height": 1.35,
        "text-padding": 10
      },
      "paint": {
        "text-color": "#42474A",
        "text-halo-color": "#0F1518",
        "text-halo-width": 0.8
      }
    },
    {
      "id": "bg-place-town",
      "type": "symbol",
      "source": "bpw-base",
      "source-layer": "place",
      "minzoom": 8,
      "maxzoom": 14,
      "filter": ["all",
        ["==", ["get", "kind"], "town"],
        ["!=", ["get", "name"], "Blacksburg"]
      ],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Prayer Walk Regular"],
        "text-transform": "uppercase",
        "text-size": [
          "interpolate", ["linear"], ["zoom"],
          8, ["step", ["to-number", ["coalesce", ["get", "rank"], 4]], 5.6, 3, 5.1],
          13, ["step", ["to-number", ["coalesce", ["get", "rank"], 4]], 6.8, 3, 6.2]
        ],
        "text-letter-spacing": 0.2,
        "text-max-width": 8,
        "text-line-height": 1.35,
        "text-padding": 10
      },
      "paint": {
        "text-color": [
          "step", ["to-number", ["coalesce", ["get", "rank"], 4]],
          "#4D5255", 3, "#484D50"
        ],
        "text-halo-color": "#0F1518",
        "text-halo-width": 0.8
      }
    }
  ]
}
