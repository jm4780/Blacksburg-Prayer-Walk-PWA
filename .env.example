# Copy to .env for local development. Never commit a filled-in copy.
#
# Deployment tier: development | pilot | public   (see api/app/config.py)
BPW_TIER=development

# Mixed into the hash of every participant token. Required outside development —
# without it a stolen database yields working bearer tokens.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BPW_TOKEN_PEPPER=

# SQLite for local work; a managed PostgreSQL URL in a real deployment.
BPW_DATABASE_URL=sqlite:///./bpw.db

# Canonical network snapshot to serve.
BPW_SNAPSHOT_DATE=2026-08-03

# Serve source-derived geometry to anonymous callers.
# LEAVE THIS FALSE until licensing gate G1 is resolved — see docs/05-licensing-status.md.
BPW_PUBLIC_GEOMETRY_ENABLED=false

BPW_CORS_ORIGINS=http://localhost:5173
