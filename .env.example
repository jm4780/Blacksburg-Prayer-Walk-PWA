# Copy to .env for local development. Never commit a filled-in copy.
#
# Deployment tier: development | pilot | public   (see api/app/config.py)
BPW_TIER=development

# Mixed into the hash of every participant token. Required outside development —
# without it a stolen database yields working bearer tokens.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
BPW_TOKEN_PEPPER=

# SQLite for local work; a managed PostgreSQL URL in a real deployment.
BPW_DATABASE_URL=sqlite:///./bpw.db

# Canonical network snapshot to serve.
BPW_SNAPSHOT_DATE=2026-08-03

# Who may see route and map geometry — the G1 control.
#   authenticated  sign-in required (set this for any pilot with a real URL)
#   invite         sign-in required, and registration needs BPW_INVITE_CODE
#   open_read      anonymous readers get geometry; registration open  (code default)
#   public         same, and stated as a public release
#
# The code default is open_read so the dashboard works before anybody signs up. That
# IS publication of source-derived geometry. Until licensing gate G1 is resolved
# (docs/05-licensing-status.md), set this to authenticated for anything reachable
# from the internet.
BPW_ACCESS_MODE=authenticated

# Legacy escape hatch. Prefer BPW_ACCESS_MODE.
BPW_PUBLIC_GEOMETRY_ENABLED=false

BPW_CORS_ORIGINS=http://localhost:5173
